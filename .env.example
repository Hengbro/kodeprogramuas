PORT=3000
NODE_ENV=production
# Kata sandi awal akun "admin" (hanya dipakai saat database pertama kali dibuat)
ADMIN_PASSWORD=ganti-dengan-sandi-kuat
# Rahasia sesi (string acak panjang). Jika kosong, dibuat otomatis dan disimpan di database.
SESSION_SECRET=
# Lokasi folder database SQLite
DATA_DIR=./data
# Set 0 jika situs diakses lewat http biasa (tanpa HTTPS) di mode production
COOKIE_SECURE=1

# Mode banyak sekolah (satu web untuk banyak sekolah, dikelola superadmin di /super)
# MULTI_SEKOLAH=1
# SUPERADMIN_USER=superadmin
# SUPERADMIN_PASSWORD=ganti-dengan-sandi-kuat
