<%- include('_top') %>
<div class="page-head"><div><h1>Daftar sekolah</h1>
  <p>Setiap sekolah punya data, admin, guru, logo, dan pengaturan sendiri yang terpisah dari sekolah lain. Admin sekolah (kepala sekolah/operator) hanya bisa mengelola sekolahnya sendiri.</p></div></div>

<div class="grid grid-3" style="margin-bottom:1rem">
  <div class="card stat"><div class="muted">Sekolah</div><div style="font-size:1.6rem;font-weight:800"><%= daftar.length %></div><small class="muted"><%= daftar.filter(s => s.aktif).length %> aktif</small></div>
  <div class="card stat"><div class="muted">Siswa aktif</div><div style="font-size:1.6rem;font-weight:800"><%= daftar.reduce((a, s) => a + (s.stat.siswa || 0), 0) %></div></div>
  <div class="card stat"><div class="muted">Guru</div><div style="font-size:1.6rem;font-weight:800"><%= daftar.reduce((a, s) => a + (s.stat.guru || 0), 0) %></div></div>
</div>

<% if (!daftar.length) { %><div class="card empty"><p>Belum ada sekolah. Tambahkan sekolah pertama di bawah.</p></div><% } %>
<% daftar.forEach(s => { %>
<div class="card sekolah-card<%= s.aktif ? '' : ' nonaktif' %>">
  <div class="card-head">
    <div><h2 style="margin:0"><%= s.nama %> <% if (!s.aktif) { %><span class="badge badge-warning">nonaktif</span><% } %></h2>
      <small class="muted">Kode <code><%= s.kode %></code><%= s.npsn ? ' · NPSN ' + s.npsn : '' %> · dibuat <%= h.tanggal(String(s.dibuat).slice(0, 10)) %></small></div>
    <div class="btn-group">
      <form method="post" action="/super/sekolah/<%= s.kode %>/masuk" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-primary" <%= s.aktif ? '' : 'disabled' %>><%- h.icon('home') %> Buka sebagai admin</button></form>
      <a class="btn btn-sm" href="/super/sekolah/<%= s.kode %>/cadangan"><%- h.icon('database') %> Cadangan</a>
      <form method="post" action="/super/sekolah/<%= s.kode %>/aktif" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm" data-confirm="<%= s.aktif ? 'Nonaktifkan sekolah ini? Guru, admin, dan portal orang tua sekolah ini tidak bisa diakses.' : 'Aktifkan kembali sekolah ini?' %>"><%= s.aktif ? 'Nonaktifkan' : 'Aktifkan' %></button></form>
    </div>
  </div>
  <% if (s.stat.error) { %><div class="alert alert-error">Database tidak bisa dibuka: <%= s.stat.error %></div><% } else { %>
  <p class="muted" style="margin:.2rem 0 .6rem"><%= s.stat.siswa %> siswa · <%= s.stat.kelas %> kelas · <%= s.stat.guru %> guru · <%= (s.stat.ukuran / 1024 / 1024).toFixed(1) %> MB
    · Masuk: <code><%= baseUrl %>/login?sekolah=<%= s.kode %></code></p>
  <% } %>
  <details>
    <summary>Kelola: akun admin, ubah data, hapus</summary>
    <div class="grid grid-2" style="margin-top:.75rem;align-items:start">
      <div>
        <h3>Akun admin sekolah</h3>
        <table class="table"><tbody>
          <% s.stat.admin.forEach(a => { %><tr><td><b><%= a.username %></b><br><small class="muted"><%= a.nama %></small></td>
            <td class="actions"><form method="post" action="/super/sekolah/<%= s.kode %>/reset" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="user_id" value="<%= a.id %>"><button class="btn btn-sm" data-confirm="Buat kata sandi baru untuk <%= a.username %>?">Reset sandi</button></form></td></tr><% }) %>
        </tbody></table>
        <form method="post" action="/super/sekolah/<%= s.kode %>/admin" style="display:flex;gap:.4rem;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="username" placeholder="username admin baru" required style="flex:1;min-width:140px" autocapitalize="none">
          <input name="nama" placeholder="nama (mis. Kepala Sekolah)" style="flex:1;min-width:140px">
          <button class="btn btn-sm"><%- h.icon('plus') %> Tambah admin</button>
        </form>
      </div>
      <div>
        <h3>Data sekolah</h3>
        <form method="post" action="/super/sekolah/<%= s.kode %>/ubah">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label>Nama sekolah (tercetak di rapor)</label><input name="nama" value="<%= s.nama %>" required></div>
          <div class="field"><label>NPSN</label><input name="npsn" value="<%= s.npsn || '' %>"></div>
          <div class="field"><label>Catatan (hanya terlihat superadmin)</label><input name="catatan" value="<%= s.catatan || '' %>" placeholder="mis. lunas Okt 2026, kontak operator"></div>
          <button class="btn btn-sm btn-primary">Simpan</button>
        </form>
        <form method="post" action="/super/sekolah/<%= s.kode %>/hapus" style="margin-top:1rem;display:flex;gap:.4rem;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="konfirmasi" placeholder="ketik <%= s.kode %> untuk menghapus" style="flex:1;min-width:160px" autocapitalize="none">
          <button class="btn btn-sm btn-danger" data-confirm="Hapus <%= s.nama %>? Semua akun tidak bisa masuk lagi. Berkas database dipindah ke folder data/terhapus.">Hapus sekolah</button>
        </form>
      </div>
    </div>
  </details>
</div>
<% }) %>

<form method="post" action="/super/sekolah" class="card" id="tambah">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Tambah sekolah baru</h2>
  <p class="muted">Sekolah baru langsung mendapat database kosong, mata pelajaran &amp; pengaturan bawaan, serta satu akun admin. Kata sandi admin dibuat acak bila dikosongkan.</p>
  <div class="grid grid-3">
    <div class="field"><label>Nama sekolah *</label><input name="nama" required placeholder="SD NEGERI 1 AMBON"></div>
    <div class="field"><label>NPSN</label><input name="npsn" inputmode="numeric"></div>
    <div class="field"><label>Kode sekolah (untuk masuk)</label><input name="kode" placeholder="otomatis dari NPSN/nama" autocapitalize="none"></div>
    <div class="field"><label>Username admin</label><input name="admin_username" value="admin" autocapitalize="none"></div>
    <div class="field"><label>Nama admin</label><input name="admin_nama" placeholder="mis. Kepala Sekolah"></div>
    <div class="field"><label>Kata sandi admin</label><div class="sandi-wrap"><input name="admin_password" placeholder="kosongkan = acak" autocomplete="new-password"><button type="button" class="btn btn-sm sandi-btn" data-sandi-acak title="Buat kata sandi acak yang kuat (otomatis disalin)">Acak</button></div></div>
  </div>
  <div class="form-actions"><button class="btn btn-primary"><%- h.icon('plus') %> Buat sekolah</button></div>
</form>
<%- include('_bottom') %>
