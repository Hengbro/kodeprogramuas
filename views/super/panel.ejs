<%- include('_top') %>
<div class="page-head"><div><h1>Daftar sekolah</h1>
  <p>Setiap sekolah punya data, admin, guru, logo, dan pengaturan sendiri yang terpisah dari sekolah lain. Admin sekolah (kepala sekolah/operator) hanya bisa mengelola sekolahnya sendiri.</p></div></div>

<div class="grid grid-3" style="margin-bottom:1rem">
  <div class="card stat"><div class="muted">Sekolah</div><div style="font-size:1.6rem;font-weight:800"><%= daftar.length %></div><small class="muted"><%= daftar.filter(s => s.aktif).length %> aktif</small></div>
  <div class="card stat"><div class="muted">Siswa aktif</div><div style="font-size:1.6rem;font-weight:800"><%= daftar.reduce((a, s) => a + (s.stat.siswa || 0), 0) %></div></div>
  <div class="card stat"><div class="muted">Guru</div><div style="font-size:1.6rem;font-weight:800"><%= daftar.reduce((a, s) => a + (s.stat.guru || 0), 0) %></div></div>
</div>

<% if (!daftar.length) { %><div class="card empty"><p>Belum ada sekolah. Tambahkan sekolah pertama di bawah.</p></div><% } %>
<% daftar.forEach(s => { %>
<div class="card sekolah-card<%= s.aktif ? '' : ' nonaktif' %>">
  <div class="card-head">
    <div><h2 style="margin:0"><a href="/super/sekolah/<%= s.kode %>" style="color:inherit"><%= s.nama %></a> <% if (!s.aktif) { %><span class="badge badge-warning">nonaktif</span><% } %></h2>
      <small class="muted">Kode <code><%= s.kode %></code><%= s.npsn ? ' · NPSN ' + s.npsn : '' %> · dibuat <%= h.tanggal(String(s.dibuat).slice(0, 10)) %></small></div>
    <div class="btn-group">
      <a class="btn btn-sm btn-primary" href="/super/sekolah/<%= s.kode %>">Detail &amp; kode akses</a>
      <form method="post" action="/super/sekolah/<%= s.kode %>/masuk" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm" <%= s.aktif ? '' : 'disabled' %>><%- h.icon('home') %> Buka sebagai admin</button></form>
      <a class="btn btn-sm" href="/super/sekolah/<%= s.kode %>/cadangan"><%- h.icon('database') %> Cadangan</a>
      <% if (offline.kunci && /^\d{8}$/.test(s.npsn || '')) { %><form method="post" action="/super/offline/kode" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sekolah" value="<%= s.nama %>"><input type="hidden" name="npsn" value="<%= s.npsn %>"><input type="hidden" name="sekolah_kode" value="<%= s.kode %>"><button class="btn btn-sm" title="Buat kode aktivasi versi offline untuk sekolah ini"><%= s.lisensi.length ? '+ Kode offline' : 'Kode offline' %></button></form><% } %>
      <form method="post" action="/super/sekolah/<%= s.kode %>/aktif" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm" data-confirm="<%= s.aktif ? 'Nonaktifkan sekolah ini? Guru, admin, dan portal orang tua sekolah ini tidak bisa diakses.' : 'Aktifkan kembali sekolah ini?' %>"><%= s.aktif ? 'Nonaktifkan' : 'Aktifkan' %></button></form>
    </div>
  </div>
  <% if (s.stat.error) { %><div class="alert alert-error">Database tidak bisa dibuka: <%= s.stat.error %></div><% } else { %>
  <p class="muted" style="margin:.2rem 0 .6rem"><%= s.stat.siswa %> siswa · <%= s.stat.kelas %> kelas · <%= s.stat.guru %> guru · <%= (s.stat.ukuran / 1024 / 1024).toFixed(1) %> MB
    · Masuk: <code><%= baseUrl %>/sekolah/<%= s.kode %>/login</code> · Portal: <code><%= baseUrl %>/sekolah/<%= s.kode %>/</code></p>
  <% } %>
  <p style="margin:-.3rem 0 .6rem"><span class="badge badge-primary">Online</span>
    <% if (s.lisensi.length) { %><span class="badge badge-success">Offline</span>
      <% s.lisensi.forEach(l => { %><a href="/super/offline/<%= l.id %>" style="font-size:.85rem">seri <%= l.seri %> · diunduh <%= l.unduhan %>×</a> <% }) %>
    <% } %></p>
  <details>
    <summary>Kelola: akun admin, ubah data, hapus</summary>
    <div class="grid grid-2" style="margin-top:.75rem;align-items:start">
      <div>
        <h3>Akun admin sekolah</h3>
        <table class="table"><tbody>
          <% s.stat.admin.forEach(a => { %><tr><td><b><%= a.username %></b><br><small class="muted"><%= a.nama %></small></td>
            <td class="actions"><form method="post" action="/super/sekolah/<%= s.kode %>/reset" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="user_id" value="<%= a.id %>"><button class="btn btn-sm" data-confirm="Buat kata sandi baru untuk <%= a.username %>?">Reset sandi</button></form></td></tr><% }) %>
        </tbody></table>
        <form method="post" action="/super/sekolah/<%= s.kode %>/admin" style="display:flex;gap:.4rem;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="username" placeholder="username admin baru" required style="flex:1;min-width:140px" autocapitalize="none">
          <input name="nama" placeholder="nama (mis. Kepala Sekolah)" style="flex:1;min-width:140px">
          <button class="btn btn-sm"><%- h.icon('plus') %> Tambah admin</button>
        </form>
      </div>
      <div>
        <h3>Data sekolah</h3>
        <form method="post" action="/super/sekolah/<%= s.kode %>/ubah">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label>Nama sekolah (tercetak di rapor)</label><input name="nama" value="<%= s.nama %>" required></div>
          <div class="field"><label>NPSN</label><input name="npsn" value="<%= s.npsn || '' %>"></div>
          <div class="field"><label>Catatan (hanya terlihat superadmin)</label><input name="catatan" value="<%= s.catatan || '' %>" placeholder="mis. lunas Okt 2026, kontak operator"></div>
          <button class="btn btn-sm btn-primary">Simpan</button>
        </form>
        <form method="post" action="/super/sekolah/<%= s.kode %>/hapus" style="margin-top:1rem;display:flex;gap:.4rem;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="konfirmasi" placeholder="ketik <%= s.kode %> untuk menghapus" style="flex:1;min-width:160px" autocapitalize="none">
          <button class="btn btn-sm btn-danger" data-confirm="Hapus <%= s.nama %>? Semua akun tidak bisa masuk lagi. Berkas database dipindah ke folder data/terhapus.">Hapus sekolah</button>
        </form>
      </div>
    </div>
  </details>
</div>
<% }) %>

<div class="card" id="offline">
  <div class="card-head"><h2 style="margin:0">Sekolah versi offline (Windows)</h2>
    <div class="btn-group">
      
      <% if (offline.panduan) { %><a class="btn btn-sm" href="/super/unduh/panduan"><%- h.icon('file') %> Panduan Admin</a><% } %>
      <% if (offline.panduanGuru) { %><a class="btn btn-sm" href="/super/unduh/panduan?untuk=guru"><%- h.icon('file') %> Panduan Guru</a><% } %>
    </div></div>
  <p class="muted">Sekolah versi offline dibuat lewat formulir <a href="#tambah">Tambah sekolah</a> di bawah (centang <b>Offline</b>). Sekolah yang online <i>dan</i> offline tampil di daftar atas dengan label Offline; di sini hanya sekolah yang <b>offline saja</b>.</p>
  <% if (!offline.kunci) { %><div class="alert alert-error">Kunci rahasia penjual tidak ada di server ini, jadi kode aktivasi belum bisa dibuat dari panel. Salin <code>kunci-penjual/kunci-rahasia.pem</code> ke server.</div><% } %>
  <% if (!offline.zip) { %><div class="alert alert-error"><b>Berkas aplikasi Windows (ZIP) belum ada di server ini</b>, sehingga sekolah tidak punya tombol unduh. Unggah file <code>E-Rapor-SD-Windows.zip</code> di bawah ini (sekali saja).</div><% } %>
  <p class="muted" style="font-size:.85rem;margin:.5rem 0 0"><b>ZIP dasar</b> (aplikasi kosong, <u>tidak untuk dibagikan</u>): dipakai server untuk membuat ZIP khusus tiap sekolah secara otomatis saat sekolah/kode dibuat. Unggah sekali, ganti hanya bila ada versi aplikasi baru.</p>
  <form class="unggah-zip" data-unggah-zip style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin:.5rem 0 1rem">
    <input type="file" accept=".zip" required>
    <button class="btn btn-sm btn-primary" type="submit"><%- h.icon('upload') %> <%= offline.zip ? 'Ganti ZIP aplikasi Windows' : 'Unggah ZIP aplikasi Windows' %></button>
    <span class="muted" data-unggah-status style="font-size:.85rem"><%= offline.zip ? 'ZIP sekarang: ' + (offline.zip.ukuran / 1024 / 1024).toFixed(0) + ' MB, ' + String(offline.zip.tanggal).slice(4, 15) : 'Pilih file E-Rapor-SD-Windows.zip (± 40 MB).' %></span>
  </form>
  <script>
  (function () {
    var f = document.querySelector('[data-unggah-zip]'); if (!f) return;
    var st = f.querySelector('[data-unggah-status]'), btn = f.querySelector('button');
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var berkas = f.querySelector('input[type=file]').files[0]; if (!berkas) return;
      var x = new XMLHttpRequest(); x.open('POST', '/super/unggah-zip');
      x.setRequestHeader('Content-Type', 'application/octet-stream');
      x.upload.onprogress = function (ev) { if (ev.lengthComputable) st.textContent = 'Mengunggah… ' + Math.round(ev.loaded * 100 / ev.total) + '%'; };
      x.onload = function () {
        var r = {}; try { r = JSON.parse(x.responseText); } catch (er) {}
        btn.disabled = false;
        if (x.status === 200 && r.ok) { st.textContent = r.pesan + ' Memuat ulang…'; setTimeout(function () { location.reload(); }, 900); }
        else { st.textContent = 'Gagal: ' + (r.pesan || ('kode ' + x.status)); st.style.color = '#b91c1c'; }
      };
      x.onerror = function () { btn.disabled = false; st.textContent = 'Gagal: koneksi terputus. Coba lagi.'; st.style.color = '#b91c1c'; };
      btn.disabled = true; st.style.color = ''; st.textContent = 'Mengunggah… 0%';
      x.send(berkas);
    });
  })();
  </script>
  <% if (!offline.saja.length) { %><p class="muted">Belum ada sekolah yang hanya memakai versi offline.</p><% } %>
  <% if (offline.saja.length) { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Tanggal</th><th>Sekolah</th><th>NPSN</th><th>No. seri</th><th class="num">Diunduh</th><th>Catatan</th><th class="actions"></th></tr></thead>
    <tbody><% offline.saja.forEach(l => { %><tr>
      <td><%= String(l.dibuat).slice(0, 10) %></td><td><b><%= l.sekolah %></b></td><td><%= l.npsn %></td><td><code><%= l.seri %></code></td>
      <td class="num"><%= l.unduhan %>×</td><td><%= l.catatan || '' %></td>
      <td class="actions"><a class="btn btn-sm" href="/super/offline/<%= l.id %>/zip"><%- h.icon('download') %> ZIP</a> <a class="btn btn-sm" href="/super/offline/<%= l.id %>">Lihat kode &amp; pesan</a></td></tr><% }) %></tbody>
  </table></div>
  <% } %>
</div>

<form method="post" action="/super/sekolah" class="card" id="tambah">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Tambah sekolah baru</h2>
  <p class="muted">Pilih versi yang dipakai sekolah. <b>Online</b>: langsung mendapat alamat web, database, dan akun admin. <b>Offline</b>: mendapat kode aktivasi + tautan unduhan aplikasi Windows. Bisa keduanya sekaligus.</p>
  <div class="field"><label>Versi</label>
    <div class="btn-group">
      <label class="checkbox"><input type="checkbox" name="online" value="1" checked data-versi="online"> Online (web)</label>
      <label class="checkbox"><input type="checkbox" name="offline" value="1" <%= offline.kunci ? '' : 'disabled' %> data-versi="offline"> Offline (Windows)<%= offline.kunci ? '' : ' — kunci penjual tidak ada' %></label>
    </div></div>
  <div class="grid grid-3">
    <div class="field"><label>Nama sekolah (seperti di rapor) *</label><input name="nama" required placeholder="SD NEGERI 1 AMBON"></div>
    <div class="field"><label>NPSN <span class="muted" data-versi-hint="offline">(wajib 8 digit untuk offline)</span></label><input name="npsn" inputmode="numeric" maxlength="8"></div>
    <div class="field"><label>Catatan</label><input name="catatan" placeholder="mis. lunas Okt 2026, kontak operator"></div>
  </div>
  <div class="grid grid-4" data-versi-blok="online">
    <div class="field"><label>Kode sekolah (alamat web)</label><input name="kode" placeholder="otomatis dari NPSN/nama" autocapitalize="none"></div>
    <div class="field"><label>Username admin</label><input name="admin_username" value="admin" autocapitalize="none"></div>
    <div class="field"><label>Nama admin</label><input name="admin_nama" placeholder="mis. Kepala Sekolah"></div>
    <div class="field"><label>Kata sandi admin</label><div class="sandi-wrap"><input name="admin_password" placeholder="kosongkan = acak" autocomplete="new-password"><button type="button" class="btn btn-sm sandi-btn" data-sandi-acak title="Buat kata sandi acak yang kuat (otomatis disalin)">Acak</button></div></div>
  </div>
  <div class="form-actions"><button class="btn btn-primary"><%- h.icon('plus') %> Buat sekolah</button></div>
</form>
<script>
  // bagian akun web hanya relevan bila versi Online dicentang
  (function () {
    var f = document.getElementById('tambah');
    var on = f.querySelector('[data-versi=online]');
    var blok = f.querySelector('[data-versi-blok=online]');
    var sinkron = function () { blok.style.display = on.checked ? '' : 'none'; };
    on.addEventListener('change', sinkron); sinkron();
  })();
</script>
<%- include('_bottom') %>
