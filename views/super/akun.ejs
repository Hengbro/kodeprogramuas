<%- include('_top') %>
<form method="post" class="card" style="max-width:480px;margin:0 auto">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h1>Ganti kata sandi superadmin</h1>
  <div class="field"><label>Kata sandi lama</label><input type="password" name="old_password" required autocomplete="current-password"></div>
  <div class="field"><label>Kata sandi baru (min. 8 karakter)</label><div class="sandi-wrap"><input type="password" name="new_password" minlength="8" required autocomplete="new-password"><button type="button" class="btn btn-sm sandi-btn" data-sandi-acak title="Buat kata sandi acak yang kuat (otomatis disalin)">Acak</button></div></div>
  <div class="form-actions"><a class="btn" href="/super">Batal</a><button class="btn btn-primary">Simpan</button></div>
</form>
<%- include('_bottom') %>
