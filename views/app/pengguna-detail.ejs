<%- include('../partials/top') %>
<div class="page-head"><div><a href="/app/pengguna" class="muted">&larr; Kembali ke daftar pengguna</a><h1><%= u.nama %></h1><p>Username <code><%= u.username %></code> · <%= u.role === 'admin' ? 'Admin' : 'Guru' %></p></div></div>
<form method="post" action="/app/pengguna/<%= u.id %>" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Data pengguna</h2>
  <div class="form-grid">
    <div class="field"><label>Nama lengkap (dengan gelar)</label><input name="nama" value="<%= u.nama %>" required></div>
    <div class="field"><label>NIP</label><input name="nip" value="<%= u.nip || '' %>"></div>
    <div class="field"><label>Username</label><input name="username" value="<%= u.username %>" autocomplete="off" required></div>
    <div class="field"><label>Peran</label><select name="role" <%= u.id === user.id ? 'disabled' : '' %>><option value="guru" <%= u.role === 'guru' ? 'selected' : '' %>>Guru</option><option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option></select></div>
    <div class="field full"><label>Kata sandi baru</label><div class="sandi-wrap"><input type="password" name="password" placeholder="kosongkan jika tidak diubah" autocomplete="new-password"><button type="button" class="btn btn-sm sandi-btn" data-sandi-acak title="Buat kata sandi acak yang kuat (otomatis disalin)">Acak</button></div><div class="hint">Minimal 6 karakter. Klik <b>Acak</b> untuk kata sandi kuat (otomatis disalin), catat sebelum menyimpan.</div></div>
    <div class="field full"><label>Guru kelas (kelas yang diampu)</label>
      <input type="hidden" name="atur_kelas" value="1">
      <% if (!kelas.length) { %><p class="muted">Belum ada kelas. Buat dulu di menu Kelas.</p><% } %>
      <div class="pilih-kelas-isi">
      <% kelas.forEach(c => { %><label><input type="checkbox" name="kelas" value="<%= c.id %>" <%= c.guru_id === u.id ? 'checked' : '' %>> Kelas <%= c.nama %><% if (c.guru_id && c.guru_id !== u.id) { %> <small class="muted">(kini: <%= c.guru_nama %> — akan dipindah ke guru ini bila dicentang)</small><% } %></label><% }) %>
      </div>
    </div>
  </div>
  <div class="form-actions">
    <a class="btn" href="/app/pengguna">Batal</a>
    <button class="btn btn-primary"><%- h.icon('check') %> Simpan perubahan</button>
  </div>
</form>
<form method="post" action="/app/pengguna/<%= u.id %>" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Lainnya</h2>
  <div class="form-actions" style="justify-content:flex-start">
    <button class="btn" name="action" value="sandi_acak" data-confirm="Buat kata sandi acak baru untuk <%= u.username %>? Kata sandi lama tidak berlaku lagi.">Reset kata sandi (acak)</button>
    <% if (u.id !== user.id) { %><button class="btn btn-danger" name="action" value="delete" data-confirm="Hapus pengguna <%= u.nama %>?"><%- h.icon('trash') %> Hapus pengguna</button><% } %>
  </div>
</form>
<%- include('../partials/bottom') %>
