<%- include('../partials/top') %>
<div class="page-head"><div><h1>Kelas / Rombongan Belajar</h1><p>Fase ditentukan otomatis: kelas I–II Fase A, III–IV Fase B, V–VI Fase C.</p></div></div>
<% if (!classes.length) { %><div class="card empty"><%- h.icon('class') %><p>Belum ada kelas.</p></div><% } else { %>
<div class="grid grid-3">
  <% classes.forEach(c => { %>
  <a class="stat" href="/app/kelas/<%= c.id %>" style="color:inherit;text-decoration:none">
    <div style="display:flex;justify-content:space-between"><b style="font-size:1.2rem">Kelas <%= c.nama %></b><span class="badge badge-primary">Fase <%= c.fase %></span></div>
    <div class="muted">Guru kelas: <%= c.guru_nama || '—' %></div>
    <div class="muted"><%= c.jumlah_siswa %> siswa aktif</div>
  </a>
  <% }) %>
</div>
<% } %>
<% if (user.role === 'admin') { %>
<form method="post" action="/app/kelas" class="card" data-track style="margin-top:1.25rem">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Tambah kelas</h2>
  <p class="muted">Bisa menambah beberapa kelas sekaligus. Baris tanpa nama kelas dilewati.</p>
  <% const barisKelas = (i) => `<tr><td class="text-cell"><input name="nama__${i}" placeholder="mis. IV A" autocomplete="off"></td>
    <td class="text-cell"><select name="tingkat__${i}">${[1, 2, 3, 4, 5, 6].map((k) => `<option value="${k}">${h.TERBILANG_KELAS[k]}</option>`).join('')}</select></td>
    <td class="text-cell"><select name="guru_id__${i}"><option value="">— pilih —</option>${gurus.map((g) => `<option value="${g.id}">${h.esc(g.nama)}</option>`).join('')}</select></td></tr>`; %>
  <input type="hidden" name="n" value="3" data-row-count>
  <div class="sheet-wrap" style="max-height:none">
  <table class="sheet" data-rows>
    <thead><tr><th>Nama kelas</th><th>Tingkat</th><th>Guru kelas</th></tr></thead>
    <tbody><% for (let i = 0; i < 3; i++) { %><%- barisKelas(i) %><% } %></tbody>
  </table>
  <template data-row-template><%- barisKelas('__I__') %></template>
  </div>
  <div class="form-actions"><button type="button" class="btn" data-add-rows="3"><%- h.icon('plus') %> Tambah baris</button><button class="btn btn-primary"><%- h.icon('check') %> Simpan kelas</button></div>
</form>
<% } %>
<%- include('../partials/bottom') %>
