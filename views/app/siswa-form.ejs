<%- include('../partials/top') %>
<div class="page-head"><div><div class="breadcrumb"><a href="/app/siswa">Data Siswa</a></div><h1><%= st.id ? 'Ubah data siswa' : 'Tambah siswa' %></h1></div></div>
<form method="post" action="<%= st.id ? '/app/siswa/' + st.id : '/app/siswa/baru' %>" class="card" data-track>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% const f = (name, label, opts = {}) => { %>
    <div class="field <%= opts.full ? 'full' : '' %>"><label for="<%= name %>"><%= label %></label><input id="<%= name %>" name="<%= name %>" type="<%= opts.type || 'text' %>" value="<%= st[name] || '' %>" <%= opts.required ? 'required' : '' %>></div>
  <% } %>
  <fieldset><legend>Data pokok</legend>
    <div class="form-grid">
      <% f('nama', 'Nama lengkap', { required: true }) %>
      <% f('panggilan', 'Nama panggilan (untuk deskripsi rapor)') %>
      <% f('nis', 'NIS') %>
      <% f('nisn', 'NISN') %>
      <% f('tempat_lahir', 'Tempat lahir') %>
      <% f('tanggal_lahir', 'Tanggal lahir', { type: 'date' }) %>
      <div class="field"><label>Jenis kelamin</label><select name="jenis_kelamin"><option value="">—</option><option value="L" <%= st.jenis_kelamin === 'L' ? 'selected' : '' %>>Laki-laki</option><option value="P" <%= st.jenis_kelamin === 'P' ? 'selected' : '' %>>Perempuan</option></select></div>
      <div class="field"><label>Agama</label><select name="agama"><option value="">—</option><% AGAMA.forEach(a => { %><option <%= st.agama === a ? 'selected' : '' %>><%= a %></option><% }) %></select></div>
      <div class="field"><label>Kelas</label><select name="class_id"><% if (user.role === 'admin') { %><option value="">— tanpa kelas —</option><% } %><% classes.forEach(c => { %><option value="<%= c.id %>" <%= st.class_id === c.id ? 'selected' : '' %>><%= c.nama %></option><% }) %></select></div>
      <% if (st.id) { %><div class="field"><label>Status</label><select name="status"><% ['aktif','pindah','lulus','keluar'].forEach(x => { %><option <%= st.status === x ? 'selected' : '' %>><%= x %></option><% }) %></select></div><% } %>
      <% f('pendidikan_sebelumnya', 'Pendidikan sebelumnya') %>
      <% f('alamat', 'Alamat peserta didik', { full: true }) %>
    </div>
  </fieldset>
  <fieldset><legend>Orang tua</legend>
    <div class="form-grid">
      <% f('ayah_nama', 'Nama ayah') %>
      <% f('ibu_nama', 'Nama ibu') %>
      <% f('ayah_pekerjaan', 'Pekerjaan ayah') %>
      <% f('ibu_pekerjaan', 'Pekerjaan ibu') %>
      <% f('ortu_jalan', 'Alamat orang tua (jalan)', { full: true }) %>
      <% f('ortu_desa', 'Kelurahan / desa') %>
      <% f('ortu_kecamatan', 'Kecamatan') %>
      <% f('ortu_kabupaten', 'Kabupaten / kota') %>
      <% f('ortu_provinsi', 'Provinsi') %>
    </div>
  </fieldset>
  <fieldset><legend>Wali peserta didik (jika ada)</legend>
    <div class="form-grid">
      <% f('wali_nama', 'Nama wali') %>
      <% f('wali_pekerjaan', 'Pekerjaan wali') %>
      <% f('wali_alamat', 'Alamat wali', { full: true }) %>
    </div>
  </fieldset>
  <details class="box" <%= st.kewarganegaraan || st.anak_ke || st.diterima_tanggal ? 'open' : '' %>>
    <summary>Data Buku Induk (opsional) — sama dengan sheet “Identitas Buku Induk”</summary>
    <p class="muted" style="margin:.5rem 0">Diisi untuk mencetak Buku Induk dan Keterangan Pindah Sekolah. Boleh dikosongkan.</p>
    <fieldset><legend>A. Keterangan diri</legend><div class="form-grid">
      <% f('kewarganegaraan', 'Kewarganegaraan') %><% f('anak_ke', 'Anak keberapa') %>
      <% f('saudara_kandung', 'Jumlah saudara kandung') %><% f('saudara_tiri', 'Jumlah saudara tiri') %>
      <% f('saudara_angkat', 'Jumlah saudara angkat') %><% f('bahasa', 'Bahasa sehari-hari di keluarga') %>
    </div></fieldset>
    <fieldset><legend>B. Tempat tinggal</legend><div class="form-grid">
      <% f('telp', 'Nomor telepon / HP') %><% f('tinggal_bersama', 'Bertempat tinggal pada/bersama') %>
      <% f('jarak_km', 'Jarak tempat tinggal ke sekolah (km)') %>
    </div></fieldset>
    <fieldset><legend>C. Kesehatan</legend><div class="form-grid">
      <% f('gol_darah', 'Golongan darah') %><% f('penyakit', 'Penyakit yang pernah diderita') %>
      <% f('kelainan', 'Kelainan jasmani') %><div></div>
      <% f('tinggi_diterima', 'Tinggi badan saat diterima (cm)') %><% f('berat_diterima', 'Berat badan saat diterima (kg)') %>
    </div></fieldset>
    <fieldset><legend>D. Pendidikan</legend><div class="form-grid">
      <% f('asal_murid', 'Asal murid (Rumah tangga / TK)') %><% f('nama_tk', 'Nama Taman Kanak-Kanak') %>
      <% f('alamat_tk', 'Alamat TK') %><% f('sttb', 'Tanggal dan nomor STTB') %>
      <% f('pindahan_sekolah', 'Pindahan dari: nama sekolah asal') %><% f('pindahan_kelas', 'Dari tingkat / kelas') %>
      <% f('pindahan_nis', 'NIS di sekolah asal') %><% f('pindahan_alasan', 'Alasan pindah') %>
      <% f('diterima_tanggal', 'Diterima di sekolah ini: tanggal', { type: 'date' }) %><% f('diterima_kelas', 'Diterima di kelas / tingkat') %>
    </div></fieldset>
    <fieldset><legend>E–G. Ayah kandung, ibu kandung, wali</legend><div class="form-grid">
      <% f('ayah_tahun_lahir', 'Ayah: tahun lahir') %><% f('ibu_tahun_lahir', 'Ibu: tahun lahir') %>
      <% f('ayah_agama', 'Ayah: agama') %><% f('ibu_agama', 'Ibu: agama') %>
      <% f('ayah_pendidikan', 'Ayah: pendidikan') %><% f('ibu_pendidikan', 'Ibu: pendidikan') %>
      <% f('wali_tahun_lahir', 'Wali: tahun lahir') %><% f('wali_agama', 'Wali: agama') %>
      <% f('wali_pendidikan', 'Wali: pendidikan') %><% f('wali_hubungan', 'Wali: hubungan keluarga') %>
    </div></fieldset>
    <fieldset><legend>H. Perkembangan peserta didik</legend><div class="form-grid">
      <% f('beasiswa', 'Menerima beasiswa (tahun, dari)', { full: true }) %>
      <% f('keluar_tanggal', 'Meninggalkan sekolah: tanggal', { type: 'date' }) %><% f('keluar_kelas', 'Kelas yang ditinggalkan') %>
      <% f('keluar_alasan', 'Alasan meninggalkan sekolah') %><% f('keluar_tujuan', 'Sekolah yang dituju') %>
      <% f('keluar_kecamatan', 'Kecamatan sekolah tujuan') %><% f('keluar_kabupaten', 'Kabupaten/kota sekolah tujuan') %>
      <% f('keluar_provinsi', 'Provinsi sekolah tujuan') %><div></div>
      <% f('lulus_tahun', 'Tamat belajar / lulus tahun') %><% f('no_ijazah', 'Nomor ijazah / STL') %>
      <% f('lanjut_ke', 'Akan melanjutkan ke', { full: true }) %>
    </div></fieldset>
  </details>
  <div class="form-actions">
    <% if (!st.id) { %><button class="btn" name="lagi" value="1">Simpan &amp; tambah lagi</button><% } %>
    <button class="btn btn-primary"><%- h.icon('check') %> Simpan</button>
  </div>
</form>
<% if (st.id && user.role === 'admin') { %>
<form method="post" action="/app/siswa/<%= st.id %>" class="card" style="display:flex;justify-content:space-between;align-items:center">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <span class="muted">Menghapus siswa akan menghapus seluruh nilai &amp; arsip rapornya. Untuk siswa pindah, ubah status saja.</span>
  <button class="btn btn-danger" name="action" value="delete" data-confirm="Hapus permanen data <%= st.nama %>?">Hapus siswa</button>
</form>
<% } %>
<%- include('../partials/bottom') %>
