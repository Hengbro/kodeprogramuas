<%- include('../partials/top') %>
<%- include('_kelas-tabs') %>
<div class="page-head"><div><h1>Cetak Rapor Kelas <%= cls.nama %></h1><p>Pilih periode dan jenis dokumen. Gunakan kertas A4; pada dialog cetak pilih “Simpan sebagai PDF” untuk arsip digital.</p></div>
  <form><select name="period" onchange="this.form.submit()" style="width:auto"><% periods.forEach(p => { %><option value="<%= p.id %>" <%= p.id === period.id ? 'selected' : '' %>><%= h.periodLabel(p) %></option><% }) %></select></form></div>

<form class="card" method="get" action="/app/kelas/<%= cls.id %>/cetak-semua/akhir" target="_blank">
  <input type="hidden" name="period" value="<%= period.id %>">
  <h2>Cetak satu kelas sekaligus</h2>
  <div class="grid grid-2">
    <div>
      <label>Halaman rapor akhir semester</label>
      <label class="checkbox"><input type="checkbox" name="part" value="cover"> Sampul</label>
      <label class="checkbox"><input type="checkbox" name="part" value="sekolah"> Identitas sekolah</label>
      <label class="checkbox"><input type="checkbox" name="part" value="identitas"> Identitas peserta didik</label>
      <label class="checkbox"><input type="checkbox" name="part" value="nilai" checked> Rapor &amp; profil peserta didik (nilai)</label>
      <div class="btn-group" style="margin-top:.6rem"><button class="btn btn-primary"><%- h.icon('print') %> Rapor akhir semester</button></div>
    </div>
    <div>
      <label>Dokumen lain</label>
      <div class="btn-group">
        <a class="btn" target="_blank" href="/app/kelas/<%= cls.id %>/cetak-semua/tts?period=<%= period.id %>">Rapor tengah semester</a>
        <% if (projects) { %><a class="btn" target="_blank" href="/app/kelas/<%= cls.id %>/cetak-semua/projek?period=<%= period.id %>">Rapor projek P5</a><a class="btn" target="_blank" href="/app/kelas/<%= cls.id %>/cetak-semua/projek?period=<%= period.id %>&part=cover&part=nilai">Rapor P5 + sampul</a><% } %>
        <span style="display:inline-flex;gap:.4rem;align-items:center;flex-wrap:nowrap;white-space:nowrap">
          <span class="btn" style="cursor:default"><%- h.icon('award') %> Piagam juara 1 s.d.</span>
          <input type="number" name="top" form="form-piagam" min="1" max="200" value="<%= settings.juara %>" style="width:64px;flex:none" aria-label="Jumlah juara">
          <select name="tpl" form="form-piagam" style="width:auto;flex:none" aria-label="Template piagam" title="Template piagam">
            <option value="">Template sekolah (no. <%= settings.piagam_template || 1 %>)</option>
            <% ['Klasik biru','Elegan emas','Modern pita samping','Sudut ornamen','Pita judul','Bingkai tebal','Gradasi warna','Minimalis','Ceria anak','Pola garis formal'].forEach((nm, i) => { %><option value="<%= i + 1 %>"><%= i + 1 %>. <%= nm %></option><% }) %>
          </select>
          <button class="btn btn-primary" form="form-piagam">Lihat / cetak piagam</button>
          <a class="btn btn-sm btn-ghost" href="/app/piagam/template" target="_blank">Lihat 10 template</a>
        </span>
        <a class="btn" target="_blank" href="/app/kelas/<%= cls.id %>/leger?print=1&period=<%= period.id %>">Leger nilai</a>
        <a class="btn" target="_blank" href="/app/kelas/<%= cls.id %>/cetak-semua/induk?period=<%= period.id %>&part=cover&part=nilai"><%- h.icon('book') %> Buku Induk kelas (+ sampul)</a>
      </div>
    </div>
  </div>
</form>

<%# formulir piagam terpisah (formulir tidak boleh bersarang di dalam formulir rapor di atas) %>
<form id="form-piagam" method="get" action="/app/kelas/<%= cls.id %>/cetak-semua/piagam" target="_blank"><input type="hidden" name="period" value="<%= period.id %>"></form>
<% if (!report.students.some(r => r.rank)) { %><div class="alert alert-info">Peringkat belum ada karena nilai belum diisi. Piagam tetap bisa dilihat sebagai <b>contoh tampilan</b> (peringkat &amp; rata-rata kosong); piagam juara terisi otomatis setelah nilai diisi.</div><% } %>
<% if (user.role === 'admin') { %><p class="muted" style="margin:-.4rem 0 1rem">Isi teks dan warna piagam bisa diatur di <a href="/app/pengaturan#piagam">Pengaturan Nilai → Isi piagam penghargaan</a>.</p><% } %>
<div class="card flush">
  <div class="card-head"><h2>Per siswa</h2></div>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th class="num">No</th><th>Nama</th><th class="num">Rata-rata</th><th class="num">Peringkat</th><th class="actions">Cetak</th></tr></thead>
    <tbody>
    <% report.students.forEach((r, i) => { const q = '?period=' + period.id; %>
      <tr><td class="num"><%= i + 1 %></td><td><%= r.student.nama %></td><td class="num"><%= h.angka(r.rata, 2) %></td><td class="num"><%= r.rank || '' %></td>
      <td class="actions">
        <a class="btn btn-sm btn-primary" target="_blank" href="/app/rapor/<%= r.student.id %>/akhir<%= q %>&part=cover&part=sekolah&part=identitas&part=nilai">Lengkap</a>
        <a class="btn btn-sm" target="_blank" href="/app/rapor/<%= r.student.id %>/akhir<%= q %>">Nilai</a>
        <a class="btn btn-sm" target="_blank" href="/app/rapor/<%= r.student.id %>/tts<%= q %>">TTS</a>
        <% if (projects) { %><a class="btn btn-sm" target="_blank" href="/app/rapor/<%= r.student.id %>/projek<%= q %>">P5</a><% } %>
        <a class="btn btn-sm" target="_blank" href="/app/rapor/<%= r.student.id %>/piagam<%= q %>" title="<%= r.rank ? 'Piagam peringkat ' + r.rank : 'Belum ada peringkat — tampil sebagai contoh' %>">Piagam</a>
        <a class="btn btn-sm" target="_blank" href="/app/rapor/<%= r.student.id %>/induk<%= q %>">Induk</a>
      </td></tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/bottom') %>
