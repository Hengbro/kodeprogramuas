<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>Selamat datang, <%= user.nama %></h1>
    <p><%= settings.nama_sekolah %> · <%= h.periodLabel(activePeriod) %></p>
  </div>
  <% if (user.role === 'admin') { %>
  <div class="btn-group">
    <a class="btn" href="/app/periode"><%- h.icon('calendar') %> Atur Periode</a>
    <a class="btn btn-primary" href="/app/kelas"><%- h.icon('plus') %> Kelas Baru</a>
  </div>
  <% } %>
</div>

<div class="grid grid-4" style="margin-bottom:1.25rem">
  <div class="stat"><div class="label">Siswa aktif</div><div class="value"><%= stats.siswa %></div></div>
  <div class="stat"><div class="label">Rombongan belajar</div><div class="value"><%= stats.kelas %></div></div>
  <div class="stat"><div class="label">Guru</div><div class="value"><%= stats.guru %></div></div>
  <div class="stat"><div class="label">Status rapor</div><div class="value" style="font-size:1.05rem;padding-top:.5rem">
    <% if (activePeriod.is_published) { %><span class="badge badge-success">Terpublikasi ke orang tua</span><% } else { %><span class="badge badge-warning">Belum dipublikasikan</span><% } %>
  </div></div>
</div>

<% if (sandiBawaan) { %>
<div class="alert alert-error">Anda masih memakai kata sandi bawaan. Siapa pun yang tahu kata sandi bawaan bisa membuka data ini. <a href="/app/akun">Ganti kata sandi sekarang</a>.</div>
<% } %>
<% if (user.role === 'admin' && !settings.npsn) { %>
<div class="alert alert-info">Lengkapi <a href="/app/sekolah">profil sekolah</a> (NPSN, kepala sekolah, alamat) agar tercetak di rapor.</div>
<% } %>
<% if (user.role === 'admin' && stats.tanpaKelas) { %>
<div class="alert alert-info"><%= stats.tanpaKelas %> siswa belum memiliki kelas. <a href="/app/siswa?kelas=none">Atur sekarang</a>.</div>
<% } %>

<div class="card">
  <div class="card-head"><h2>Kelas <%= user.role === 'admin' ? '' : 'yang Anda ampu' %></h2></div>
  <% if (!classes.length) { %>
    <div class="empty"><%- h.icon('class') %><p><%= user.role === 'admin' ? 'Belum ada kelas. Buat kelas pertama Anda.' : 'Anda belum ditetapkan sebagai guru kelas. Hubungi admin.' %></p>
      <% if (user.role === 'admin') { %><a class="btn btn-primary" href="/app/kelas">Buat Kelas</a><% } %></div>
  <% } else { %>
  <div class="grid grid-3">
    <% classes.forEach(c => { const pct = Math.min(100, Math.round(c.progress.nilai / Math.max(1, c.progress.mapel) * 100)); %>
    <a href="/app/kelas/<%= c.id %>" class="stat" style="color:inherit;text-decoration:none">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div style="font-size:1.25rem;font-weight:800">Kelas <%= c.nama %></div>
        <span class="badge badge-primary">Fase <%= c.fase %></span>
      </div>
      <div class="muted" style="margin:.25rem 0 .75rem"><%= c.guru_nama || 'Belum ada guru kelas' %> · <%= c.jumlah_siswa %> siswa</div>
      <div class="progress"><span style="width:<%= pct %>%"></span></div>
      <small><%= c.progress.nilai %> dari <%= c.progress.mapel %> mapel sudah dinilai · <%= c.progress.tp %> TP</small>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="card">
  <h2>Alur kerja pengisian rapor</h2>
  <div class="grid grid-4">
    <div><span class="badge badge-primary">1</span><p style="margin-top:.4rem"><b>Data utama</b><br><span class="muted">Profil sekolah, periode, kelas, guru, siswa.</span></p></div>
    <div><span class="badge badge-primary">2</span><p style="margin-top:.4rem"><b>TP &amp; Lingkup Materi</b><br><span class="muted">Isi per mapel, atau pakai contoh TP kelas IV.</span></p></div>
    <div><span class="badge badge-primary">3</span><p style="margin-top:.4rem"><b>Input nilai</b><br><span class="muted">Formatif, sumatif, SAS, ekskul, absensi, catatan, P5.</span></p></div>
    <div><span class="badge badge-primary">4</span><p style="margin-top:.4rem"><b>Cetak &amp; publikasi</b><br><span class="muted">Cetak rapor A4 dan buka portal orang tua.</span></p></div>
  </div>
</div>
<%- include('../partials/bottom') %>
